# Backend only. Use the existing debate environment for TreeDebater's heavy dependencies.
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# TOGETHERAI_API_KEY=
# DEEPSEEK_API_KEY=
# Optional; defaults below work for local development.
# DEBATE_APP_DATA=/absolute/path/to/TreeDebater/debate-app/var
# DEBATE_APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DEBATE_APP_MAX_ACTIVE_SESSIONS=2
# DEBATE_APP_RECONNECT_GRACE_SECONDS=120
# DEBATE_APP_UNSTARTED_TIMEOUT_SECONDS=120
# Frontend NEXT_PUBLIC_DEBATE_API can target a separately hosted HTTPS Python service.
